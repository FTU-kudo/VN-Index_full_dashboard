# .env.example — Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env vào git (đã gitignored)

# ════════════════════════════════════════════════════════════════
# Google AI Studio API Key
# Lấy tại: https://aistudio.google.com/app/apikey
# ════════════════════════════════════════════════════════════════
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# ════════════════════════════════════════════════════════════════
# Yuanta API (không cần key — public API)
# Base URL đã được cấu hình sẵn trong yuanta/config.py
# ════════════════════════════════════════════════════════════════
# YUANTA_BASE_URL=https://ysradarapi.yuanta.com.vn/api/v3  # default

# ════════════════════════════════════════════════════════════════
# Dashboard deployment (chỉ cần nếu không dùng GitHub Pages)
# ════════════════════════════════════════════════════════════════
# DASHBOARD_BASE_URL=https://FTU-kudo.github.io/VN-Index_full_dashboard/data
